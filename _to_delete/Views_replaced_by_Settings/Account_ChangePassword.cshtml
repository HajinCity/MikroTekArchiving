@model MikroTek.Archiving.Areas.Portal.Models.ChangePasswordInput
@{ ViewData["Title"] = "Change password"; ViewData["Crumb"] = "My account"; }
<div class="card" style="max-width:520px">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
        <form asp-action="ChangePassword" method="post">
            <div class="mb-3">
                <label class="form-label" for="cur">Current password</label>
                <input id="cur" name="CurrentPassword" type="password" class="form-control" autocomplete="current-password" required autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label" for="new">New password</label>
                <input id="new" name="NewPassword" type="password" class="form-control" autocomplete="new-password" minlength="@MikroTek.Services.CoreServices.UserServices.MinPasswordLength" required />
                <div class="form-text">At least @MikroTek.Services.CoreServices.UserServices.MinPasswordLength characters. A short sentence is easier to remember than random letters.</div>
            </div>
            <div class="mb-4">
                <label class="form-label" for="confirm">Type the new password again</label>
                <input id="confirm" name="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" required />
            </div>
            <button class="btn btn-primary"><i class="bi bi-key me-1"></i>Change password</button>
            <a class="btn btn-light ms-1" asp-controller="Dashboard" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
