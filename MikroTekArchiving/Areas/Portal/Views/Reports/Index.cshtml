@model ReportsPage
@{
    ViewData["Title"] = "Liquidation Reports";
    ViewData["Crumb"] = "Reports";
    var noAdvances = Model.CashAdvances.Count == 0;
    var noDvs = Model.Vouchers.Count == 0;
}
<div class="row g-3">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="kpi p-0 mb-3"><div class="icon"><i class="bi bi-journal-richtext"></i></div>
                    <div><div class="fw-bold">Cash Disbursements Register</div><div class="small text-body-secondary">Appendix 43 · per cash advance, with breakdown by UACS account and recapitulation.</div></div></div>
                <form asp-action="Register" method="get">
                    <label class="form-label">Cash advance</label>
                    <select class="form-select mb-3" name="id" disabled="@noAdvances">
                        @if (noAdvances) { <option>No cash advances yet</option> }
                        @foreach (var ca in Model.CashAdvances) { <option value="@ca.Id">@ca.Dept · @ca.PayrollNo · @ca.Period</option> }
                    </select>
                    <button class="btn btn-primary w-100" disabled="@noAdvances"><i class="bi bi-printer me-1"></i>Open for printing</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="kpi p-0 mb-3"><div class="icon gold"><i class="bi bi-person-lines-fill"></i></div>
                    <div><div class="fw-bold">Alphalist of Payees</div><div class="small text-body-secondary">Payees from whom taxes were withheld (1% / 3% non-VAT, 1% / 5% VAT), with TIN.</div></div></div>
                <form asp-action="Alphalist" method="get">
                    <label class="form-label">Cash advance</label>
                    <select class="form-select mb-3" name="id" disabled="@noAdvances">
                        @if (noAdvances) { <option>No cash advances yet</option> }
                        @foreach (var ca in Model.CashAdvances) { <option value="@ca.Id">@ca.Dept · @ca.PayrollNo · @ca.Period</option> }
                    </select>
                    <button class="btn btn-primary w-100" disabled="@noAdvances"><i class="bi bi-printer me-1"></i>Open for printing</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="kpi p-0 mb-3"><div class="icon green"><i class="bi bi-folder-check"></i></div>
                    <div><div class="fw-bold">DV Archive Record</div><div class="small text-body-secondary">One voucher's details, accounting entry and checklist cover sheet.</div></div></div>
                <form asp-controller="Vouchers" asp-action="Print" method="get">
                    <label class="form-label">Disbursement voucher</label>
                    <select class="form-select mb-3" name="id" disabled="@noDvs">
                        @if (noDvs) { <option>No DVs yet</option> }
                        @foreach (var v in Model.Vouchers) { <option value="@v.Id">@v.DvNo · @v.Payee</option> }
                    </select>
                    <button class="btn btn-primary w-100" disabled="@noDvs"><i class="bi bi-printer me-1"></i>Open for printing</button>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="alert alert-light border mt-3 small mb-0"><i class="bi bi-lightbulb text-warning"></i> Tip: reports open in a print view. Use <b>Print</b> and choose <b>Save as PDF</b> to keep a digital copy.</div>
