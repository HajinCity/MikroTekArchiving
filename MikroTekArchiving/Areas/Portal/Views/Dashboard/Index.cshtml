@model DashboardData
@{
    ViewData["Title"] = "Dashboard";
    var f = Model.Filter;
    var dvs = Model.Vouchers;
    var incomplete = Model.Incomplete;
    var today = DateTime.Today;

    // Quick date choices
    var thisMonth = new DateTime(today.Year, today.Month, 1);
    var presets = new (string Text, DateTime From, DateTime To)[]
    {
        ("This month", thisMonth, thisMonth.AddMonths(1).AddDays(-1)),
        ("Last month", thisMonth.AddMonths(-1), thisMonth.AddDays(-1)),
        ("This year", new DateTime(today.Year, 1, 1), new DateTime(today.Year, 12, 31)),
        ("Last year", new DateTime(today.Year - 1, 1, 1), new DateTime(today.Year - 1, 12, 31)),
    };

    // Net per month. Each department keeps its own colour (JHS blue, SHS orange) even when the other is filtered out.
    var series = new List<ChartSeries>();
    if (f.IncludesDept("JHS")) { series.Add(new("Junior High", Model.Months.Select(m => m.Jhs), Color: 1)); }
    if (f.IncludesDept("SHS")) { series.Add(new("Senior High", Model.Months.Select(m => m.Shs), Color: 2)); }
    var monthly = new ChartSpec(ChartType.Bar, Model.Months.Select(m => m.Month.ToString("MMM yyyy")), series,
        "Net disbursed per month", $"{f.DeptText} · {f.RangeText}");

    var donut = new ChartSpec(ChartType.Donut, Model.ByType.Select(x => x.Name), [new("Gross", Model.ByType.Select(x => x.Amount))],
        "Spending by transaction type", $"Gross amounts · {dvs.Count} DVs");

    var top = Model.ByAccount.Take(5).ToList();
    if (Model.ByAccount.Count > 5) { top.Add(new AmountRow($"Other ({Model.ByAccount.Count - 5})", null, Model.ByAccount.Skip(5).Sum(x => x.Amount))); }
    var accountChart = new ChartSpec(ChartType.HBar, top.Select(x => x.Name), [new("Gross", top.Select(x => x.Amount))],
        "Top expense accounts", "UACS accounts by gross amount", Height: 280);

    var recent = DataGrid.For(dvs.OrderByDescending(v => v.Date).ThenByDescending(v => v.DvNo))
        .Text("DV No.", v => v.DvNo, href: v => Url.Action("Details", "Vouchers", new { id = v.Id }), nowrap: true)
        .Date("Date", v => v.Date, hideOnMobile: true)
        .Text("Payee", v => v.Payee)
        .Money("Net", v => v.Net)
        .Badge("Packet", v => v.IsComplete ? "Complete" : "Incomplete", v => v.IsComplete ? "green" : "orange")
        .Build("recentDvs", pageSize: 5, searchable: false, exportable: false, compact: true);
}

<div class="page-actions">
    <div class="me-auto text-body-secondary">@(DateTime.Now.Hour < 12 ? "Good morning" : DateTime.Now.Hour < 18 ? "Good afternoon" : "Good evening"), <b>@User.FirstName()</b>. Here's the status of the disbursement archive.</div>
    @if (User.Can(Permissions.VouchersEncode))
    {
        <a class="btn btn-primary" asp-controller="Vouchers" asp-action="Upload"><i class="bi bi-cloud-arrow-up me-1"></i>Upload Scanned DV</a>
    }
    @if (User.Can(Permissions.CashAdvancesEncode))
    {
        <a class="btn btn-outline-primary" asp-controller="CashAdvances" asp-action="Create"><i class="bi bi-cash-stack me-1"></i>Record Cash Advance</a>
    }
</div>

<!-- Filter: everything below follows these dates and this department; Export writes the same data to Excel -->
<form class="card dash-filter mb-3" asp-action="Index" method="get">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-auto">
                <label class="form-label" for="fFrom">From</label>
                <input id="fFrom" name="from" type="date" class="form-control" value="@f.From.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-6 col-md-auto">
                <label class="form-label" for="fTo">To</label>
                <input id="fTo" name="to" type="date" class="form-control" value="@f.To.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-12 col-md-auto">
                <label class="form-label" for="fDept">Department</label>
                <select id="fDept" name="dept" class="form-select">
                    <option value="" selected="@(f.Dept is null)">All departments</option>
                    <option value="JHS" selected="@(f.Dept == "JHS")">Junior High (JHS)</option>
                    <option value="SHS" selected="@(f.Dept == "SHS")">Senior High (SHS)</option>
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Apply</button>
                <a class="btn btn-light" asp-action="Index">Reset</a>
            </div>
            <div class="col-12 col-lg-auto ms-lg-auto">
                <a class="btn btn-success" asp-action="Export" asp-all-route-data="f.Route()" title="Download what is shown here as an Excel file">
                    <i class="bi bi-file-earmark-excel me-1"></i>Export to Excel</a>
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2 small">
            <span class="text-body-secondary">Quick dates:</span>
            @foreach (var p in presets)
            {
                var on = p.From == f.From && p.To == f.To;
                <a class="ui-pill @(on ? "tone-blue" : "tone-gray") text-decoration-none" asp-action="Index" asp-all-route-data="f.Route(p.From, p.To)" aria-current="@(on ? "true" : null)">@p.Text</a>
            }
            <span class="text-body-secondary ms-auto">Showing <b>@dvs.Count</b> DV(s) dated @f.RangeText · @f.DeptText</span>
        </div>
    </div>
</form>

<!-- Fund cards: budget for @f.BudgetYear, follows the department filter -->
<div class="row g-3 mb-3">
    @foreach (var fund in Model.Funds)
    {
        <div class="@(Model.Funds.Count > 2 ? "col-sm-6 col-xl-3" : "col-md-6")"><partial name="_FundCard" model="fund" /></div>
    }
</div>

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3"><partial name="UI/_StatCard" model="@(new StatCard("DVs archived", dvs.Count.ToString(), "bi-folder2-open", "blue", Hint: f.RangeText, Href: Url.Action("Index", "Vouchers", new { dept = f.Dept })))" /></div>
    <div class="col-sm-6 col-xl-3"><partial name="UI/_StatCard" model="@(new StatCard("Total disbursed (net)", Fmt.Peso(Model.Net), "bi-cash-coin", "aqua", Hint: "Gross " + Fmt.Peso(Model.Gross)))" /></div>
    <div class="col-sm-6 col-xl-3"><partial name="UI/_StatCard" model="@(new StatCard("Taxes withheld", Fmt.Peso(Model.Taxes), "bi-receipt", "orange", Hint: "To be remitted to BIR", Href: Url.Action("Index", "Reports")))" /></div>
    <div class="col-sm-6 col-xl-3"><partial name="UI/_StatCard" model="@(new StatCard("Incomplete DV packets", incomplete.Count.ToString(), "bi-exclamation-triangle", "red", Hint: "Missing documents or no scan", Href: Url.Action("Index", "Vouchers", new { status = "incomplete", dept = f.Dept })))" /></div>
</div>

@if (dvs.Count == 0)
{
    <div class="card mb-3"><div class="card-body">
        <partial name="UI/_EmptyState" model="@(new EmptyState("No DVs in these dates", $"Nothing is dated {f.RangeText} for {f.DeptText}. Try other dates or press Reset.", "bi-calendar-x"))" />
    </div></div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-xl-8"><ui-card class="h-100"><partial name="UI/_Chart" model="monthly" /></ui-card></div>
        <div class="col-xl-4"><ui-card class="h-100"><partial name="UI/_Chart" model="accountChart" /></ui-card></div>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-xl-7">
        <ui-card title="Cash advances" subtitle="Utilization to date" icon="bi-cash-stack" class="h-100">
            <ui-card-tools><a asp-controller="CashAdvances" asp-action="Index">View all</a></ui-card-tools>
            @if (Model.CashAdvances.Count == 0)
            {
                <partial name="UI/_EmptyState" model="@(new EmptyState("No cash advances yet", "They appear here once the first School MOOE Slip is recorded.", "bi-cash-stack"))" />
            }
            @foreach (var ca in Model.CashAdvances)
            {
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="dept dept-@ca.Dept">@ca.Dept</span>
                        <a class="fw-semibold text-decoration-none" asp-controller="CashAdvances" asp-action="Details" asp-route-id="@ca.Id">@ca.PayrollNo</a>
                        <span class="text-body-secondary small d-none d-sm-inline">· @ca.FundName · Batch @ca.BatchNo.ToString("00") · @ca.Period</span>
                        <span class="ui-pill @(ca.IsOpen ? "tone-blue" : "tone-gray") ms-auto">@ca.Status</span>
                    </div>
                    <partial name="UI/_Meter" model="@(new Meter(null, ca.Amount, [new("Spent", ca.Spent, "s1"), new("Balance", Math.Max(ca.Balance, 0), "track")]))" />
                </div>
            }
        </ui-card>
    </div>
    <div class="col-xl-5">
        <ui-card title="Needs attention" icon="bi-exclamation-circle" flush="true" class="h-100">
            <ui-card-tools><a asp-controller="Vouchers" asp-action="Index" asp-route-status="incomplete">View all</a></ui-card-tools>
            <div class="list-group list-group-flush">
                @foreach (var v in incomplete)
                {
                    <a class="list-group-item list-group-item-action py-3" asp-controller="Vouchers" asp-action="Details" asp-route-id="@v.Id">
                        <div class="d-flex align-items-center gap-2">
                            <span class="dept dept-@v.Dept">@v.Dept</span>
                            <span class="fw-semibold">@v.DvNo</span>
                            <span class="ui-pill tone-orange ms-auto">@(v.DocsMissing > 0 ? $"{v.DocsMissing} missing" : "no scan")</span>
                        </div>
                        <div class="small text-body-secondary text-truncate mt-1">@v.Payee · @Fmt.Peso(v.Net)</div>
                        <div class="small text-danger text-truncate">@(v.DocsMissing > 0 ? string.Join(", ", v.Checklist.Where(c => c.Mark == "").Select(c => c.Label).Take(2)) + (v.DocsMissing > 2 ? "…" : "") : "The scanned packet is not attached yet")</div>
                    </a>
                }
                @if (incomplete.Count == 0)
                {
                    <div class="list-group-item py-4 text-center text-body-secondary small"><i class="bi bi-check2-circle text-success"></i> Every DV packet in these dates is complete.</div>
                }
            </div>
        </ui-card>
    </div>
</div>

@if (dvs.Count > 0)
{
    <div class="row g-3">
        <div class="col-xl-5"><ui-card class="h-100"><partial name="UI/_Chart" model="donut" /></ui-card></div>
        <div class="col-xl-7">
            <ui-card title="DVs in these dates" icon="bi-folder2-open" flush="true" class="h-100">
                <ui-card-tools><a asp-controller="Vouchers" asp-action="Index">Open archive</a></ui-card-tools>
                <partial name="UI/_DataGrid" model="recent" />
            </ui-card>
        </div>
    </div>
}
