@model SchoolProfileDto
@{ ViewData["Title"] = "School & Signatories"; ViewData["Crumb"] = "Setup"; }
<form asp-action="SaveSchool" method="post" class="row g-3" style="max-width:1100px">
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-header">School profile <span class="sub">— used in report headers</span></div>
            <div class="card-body row g-3">
                <div class="col-12"><label class="form-label" for="sName">School name</label><input class="form-control" id="sName" name="SchoolName" value="@Model.SchoolName" maxlength="200" required /></div>
                <div class="col-md-6"><label class="form-label" for="sRegion">Region</label><input class="form-control" id="sRegion" name="Region" value="@Model.Region" maxlength="150" /></div>
                <div class="col-md-6"><label class="form-label" for="sDivision">Division</label><input class="form-control" id="sDivision" name="Division" value="@Model.Division" maxlength="150" /></div>
                <div class="col-md-6"><label class="form-label" for="sDistrict">District</label><input class="form-control" id="sDistrict" name="District" value="@Model.District" maxlength="150" /></div>
                <div class="col-md-6"><label class="form-label" for="sAddress">Address</label><input class="form-control" id="sAddress" name="Address" value="@Model.Address" maxlength="250" /></div>
                <div class="col-md-6"><label class="form-label" for="sJhsBank">JHS bank account</label><input class="form-control" id="sJhsBank" name="JhsBankAccount" value="@Model.JhsBankAccount" maxlength="100" placeholder="Bank and account no." /></div>
                <div class="col-md-6"><label class="form-label" for="sShsBank">SHS bank account</label><input class="form-control" id="sShsBank" name="ShsBankAccount" value="@Model.ShsBankAccount" maxlength="100" placeholder="Bank and account no." /></div>
                <div class="col-md-6"><label class="form-label" for="sRc">Responsibility Center</label><input class="form-control" id="sRc" name="ResponsibilityCenter" value="@Model.ResponsibilityCenter" maxlength="50" /></div>
                <div class="col-md-6"><label class="form-label" for="sCluster">Default fund cluster</label><input class="form-control" id="sCluster" name="FundCluster" value="@Model.FundCluster" maxlength="50" /></div>
                <div class="col-12 form-text mt-2"><i class="bi bi-info-circle me-1"></i>The bank accounts, responsibility center and fund cluster are filled in by themselves on new DVs and cash advances.</div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-header">Signatories <span class="sub">— printed on the DV record, CDR and Alphalist</span></div>
            <div class="card-body">
                @foreach (var (role, field, name, pos) in new[] {
                    ("School Head / Accountable Officer", "Head", Model.HeadName, Model.HeadPosition),
                    ("Bookkeeper (Checked / Prepared by)", "Bookkeeper", Model.BookkeeperName, Model.BookkeeperPosition),
                    ("Validator (Received by)", "Validator", Model.ValidatorName, Model.ValidatorPosition),
                    ("Cash Unit (MOOE Slip verified by)", "CashUnit", Model.CashUnitName, Model.CashUnitPosition) })
                {
                    <div class="mb-3"><div class="section-title mb-2">@role</div>
                        <div class="row g-2">
                            <div class="col-md-6"><input class="form-control" name="@(field)Name" value="@name" maxlength="150" placeholder="Name" aria-label="@role: name" /></div>
                            <div class="col-md-6"><input class="form-control" name="@(field)Position" value="@pos" maxlength="150" placeholder="Position" aria-label="@role: position" /></div>
                        </div></div>
                }
            </div>
        </div>
    </div>
    <div class="col-12 text-end"><button class="btn btn-primary"><i class="bi bi-save me-1"></i>Save settings</button></div>
</form>
