@{ ViewData["Title"] = "School & Signatories"; ViewData["Crumb"] = "Setup"; }
<form asp-action="Save" asp-route-back="School" method="post" class="row g-3" style="max-width:1100px">
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-header">School profile <span class="sub">— used in report headers</span></div>
            <div class="card-body row g-3">
                <div class="col-12"><label class="form-label">School name</label><input class="form-control" value="Leonardo National High School" /></div>
                <div class="col-md-6"><label class="form-label">Region</label><input class="form-control" value="Region IX, Zamboanga Peninsula" /></div>
                <div class="col-md-6"><label class="form-label">Division</label><input class="form-control" value="Division of Zamboanga del Sur" /></div>
                <div class="col-md-6"><label class="form-label">District</label><input class="form-control" value="Josefina District" /></div>
                <div class="col-md-6"><label class="form-label">Address</label><input class="form-control" value="Leonardo, Josefina, Zamboanga del Sur" /></div>
                <div class="col-md-6"><label class="form-label">JHS bank account</label><input class="form-control" value="DBP Pagadian 0-06071-840-8" /></div>
                <div class="col-md-6"><label class="form-label">SHS bank account</label><input class="form-control" placeholder="Bank and account no." /></div>
                <div class="col-md-6"><label class="form-label">Responsibility Center</label><input class="form-control" value="100010000" /></div>
                <div class="col-md-6"><label class="form-label">Default fund cluster</label><input class="form-control" value="Regular" /></div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-header">Signatories <span class="sub">— printed on the DV record, CDR and Alphalist</span></div>
            <div class="card-body">
                @foreach (var (role, name, pos) in new[] {
                    ("School Head / Accountable Officer", "Jessiebel M. Cana", "School Principal II"),
                    ("Bookkeeper (Checked / Prepared by)", "Anely R. Villegas", "ADAS III / Senior Bookkeeper"),
                    ("Validator (Received by)", "Riza P. Quiroga", "Validator / ADAS III"),
                    ("Cash Unit (MOOE Slip verified by)", "Ercel C. Monternel", "Administrative Officer IV – Cash Unit") })
                {
                    <div class="mb-3"><div class="section-title mb-2">@role</div>
                        <div class="row g-2"><div class="col-md-6"><input class="form-control" value="@name" /></div><div class="col-md-6"><input class="form-control" value="@pos" /></div></div></div>
                }
            </div>
        </div>
    </div>
    <div class="col-12 text-end"><button class="btn btn-primary"><i class="bi bi-save me-1"></i>Save settings</button></div>
</form>
