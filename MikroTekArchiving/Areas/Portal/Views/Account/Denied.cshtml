@{ ViewData["Title"] = "No access"; }
<div class="card mx-auto" style="max-width:560px">
    <div class="card-body text-center p-5">
        <i class="bi bi-shield-lock text-warning" style="font-size:3rem"></i>
        <h2 class="h4 mt-3">You don't have access to this page</h2>
        <p class="text-body-secondary mb-4">
            You are signed in as <b>@User.FullName()</b> (@User.RoleName()).
            This page is for @(User.IsInRole("Viewer") ? "Bookkeepers and Admins" : "Admins") only.
            If you need it, please ask the admin to change your role.
        </p>
        <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Back to the dashboard</a>
    </div>
</div>
