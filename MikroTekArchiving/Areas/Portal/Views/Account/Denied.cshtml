@{ ViewData["Title"] = "No access"; }
<div class="card mx-auto" style="max-width:560px">
    <div class="card-body text-center p-5">
        <i class="bi bi-shield-lock text-warning" style="font-size:3rem"></i>
        <h2 class="h4 mt-3">You don't have access to this page</h2>
        <p class="text-body-secondary mb-4">
            You are signed in as <b>@User.FullName()</b> (@User.RoleDisplay()).
            Your role is not allowed to use this feature.
            If you need it, please ask the System Admin to give your role access.
        </p>
        <a class="btn btn-primary" asp-controller="Account" asp-action="Home"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>
