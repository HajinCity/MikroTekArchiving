@model List<CashAdvanceDto>
@{
    ViewData["Title"] = "Cash Advances";
    ViewData["Crumb"] = "Disbursements";
    var canAdd = User.Can(Permissions.CashAdvancesEncode);
    var grid = DataGrid.For(Model)
        .Text("Dept", c => c.Dept)
        .Text("Fund", c => c.FundName, hideOnMobile: true)
        .Text("Batch", c => c.BatchNo.ToString("00"))
        .Text("Payroll No.", c => c.PayrollNo, href: c => Url.Action("Details", new { id = c.Id }), nowrap: true)
        .Text("ADA No.", c => c.AdaNo, hideOnMobile: true, css: "mono")
        .Date("Date", c => c.Date, hideOnMobile: true)
        .Text("Period Covered", c => c.Period, hideOnMobile: true)
        .Money("Amount", c => c.Amount, total: true)
        .Money("Spent", c => c.Spent, total: true, hideOnMobile: true)
        .Money("Balance", c => c.Balance, total: true)
        .Html("Utilization", c => $"<div class=\"progress\" style=\"min-width:110px\"><div class=\"progress-bar\" style=\"width:{Math.Clamp(c.PercentUsed, 0, 100)}%\"></div></div><small class=\"text-body-secondary\">{c.PercentUsed}% · {c.Vouchers.Count} DVs</small>", hideOnMobile: true)
        .Badge("Status", c => c.Status, c => c.IsOpen ? "blue" : "gray")
        .Actions(c => $"<a class=\"btn btn-sm btn-outline-primary\" href=\"{Url.Action("Details", new { id = c.Id })}\">Open</a>")
        .Build("caGrid", searchable: true, exportName: "cash-advances");
}
<div class="page-actions">
    <div class="me-auto text-body-secondary">MOOE cash advances released to the school (School MOOE Slip). Every DV is charged against one.</div>
    @if (canAdd)
    {
        @if (User.Can(Permissions.VouchersEncode))
        {
            <a class="btn btn-outline-primary" asp-controller="Import" asp-action="Index"><i class="bi bi-magic me-1"></i>Import MOOE Packet</a>
        }
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Record Cash Advance</a>
    }
</div>
@if (Model.Count == 0)
{
    <div class="card"><div class="card-body">
        <partial name="UI/_EmptyState" model="@(new EmptyState("No cash advances yet", canAdd ? "Record the first School MOOE Slip. DVs are then charged against it." : "Nothing has been recorded yet.", "bi-cash-stack",
            canAdd ? "Record Cash Advance" : null, Url.Action("Create")))" />
    </div></div>
}
else
{
    <ui-card title="Cash advances" icon="bi-cash-stack" flush="true">
        <partial name="UI/_DataGrid" model="grid" />
    </ui-card>
}
