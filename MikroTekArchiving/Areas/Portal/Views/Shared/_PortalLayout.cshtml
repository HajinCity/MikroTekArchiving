@*
    Main layout of the Disbursement Archiving Portal, built on the reusable UI kit (wwwroot/ui).
    Top bar (dark) · left sidebar (collapsible) · page bar with breadcrumb · content.
    Pages set: ViewData["Title"] and optionally ViewData["Crumb"] = "Section / Sub-section".
*@
@inject MikroTek.Services.Interface.IDisbursements Disbursements
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string A(bool on) => on ? "active" : "";
    bool Is(string c, params string[] actions) => controller == c && (actions.Length == 0 || actions.Contains(action));
    var title = ViewData["Title"] as string ?? "Portal";
    var crumbs = (ViewData["Crumb"] as string)?.Split(" / ", StringSplitOptions.RemoveEmptyEntries) ?? [];
    bool Can(string permission) => User.Can(permission);
    // Numbers for the bell and the "Upload Scanned DV" badge (only for people who can see DVs).
    var alerts = User.Can(Permissions.VouchersView) ? await Disbursements.GetAlertsAsync() : new ArchiveAlerts(0, 0);
    var canEncode = User.Can(Permissions.VouchersEncode);
    var alertCount = (canEncode && alerts.Drafts > 0 ? 1 : 0) + (alerts.Incomplete > 0 ? 1 : 0);
    var canSetup = User.CanAny(Permissions.SetupPayees, Permissions.SetupAccounts, Permissions.SetupBudgets, Permissions.SetupChecklists, Permissions.SetupSchool);
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title · Disbursement Archive</title>
    <script>/* apply saved theme before paint (no flash) */try { var t = localStorage.getItem("ui.theme"); if (t) document.documentElement.dataset.bsTheme = t; if (localStorage.getItem("ui.sidebarMini") === "1") document.documentElement.classList.add("sidebar-mini"); } catch (e) { }</script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/ui/ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/portal/css/portal.css" asp-append-version="true" />
</head>
<body class="app">
    <!-- ============ TOP BAR ============ -->
    <header class="app-topbar">
        <a class="app-brand" asp-controller="Account" asp-action="Home">
            <span class="app-logo"><i class="bi bi-archive-fill"></i></span>
            <span class="app-brand-text">DV ARCHIVE<small>Leonardo National High School</small></span>
        </a>
        <button class="app-icon-btn" type="button" data-ui-sidebar-toggle aria-label="Toggle menu"><i class="bi bi-list"></i></button>
        @if (Can(Permissions.VouchersView))
        {
        <form class="app-search d-none d-md-block" asp-controller="Vouchers" asp-action="Index" method="get" role="search">
            <i class="bi bi-search"></i>
            <input name="q" class="form-control form-control-sm" placeholder="Search DV no., payee, check no." aria-label="Search" />
        </form>
        }
        <div class="ms-auto d-flex align-items-center gap-1">
            <button class="app-icon-btn d-none d-md-grid" type="button" data-ui-fullscreen title="Full screen"><i class="bi bi-arrows-fullscreen"></i></button>
            <button class="app-icon-btn" type="button" data-ui-theme-toggle title="Light / dark mode"><i class="bi bi-moon-stars"></i></button>
            <div class="dropdown">
                <button class="app-icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                    <i class="bi bi-bell"></i>@if (alertCount > 0) { <span class="app-dot">@alertCount</span> }
                </button>
                <div class="dropdown-menu dropdown-menu-end p-0" style="width:320px">
                    <div class="px-3 py-2 fw-semibold border-bottom">Notifications</div>
                    @if (canEncode && alerts.Drafts > 0)
                    {
                        <a class="dropdown-item py-2 text-wrap" asp-controller="Vouchers" asp-action="Upload"><i class="bi bi-cloud-arrow-up text-primary me-2"></i>@alerts.Drafts uploaded scan(s) waiting to be encoded</a>
                    }
                    @if (alerts.Incomplete > 0)
                    {
                        <a class="dropdown-item py-2 text-wrap" asp-controller="Vouchers" asp-action="Index" asp-route-status="incomplete"><i class="bi bi-exclamation-triangle text-warning me-2"></i>@alerts.Incomplete DV packet(s) with missing documents or no scan</a>
                    }
                    @if (alertCount == 0)
                    {
                        <div class="px-3 py-3 small text-body-secondary"><i class="bi bi-check2-circle text-success me-1"></i>Nothing needs attention.</div>
                    }
                </div>
            </div>
            <div class="dropdown ms-1">
                <button class="app-user" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="app-avatar">@User.Initials()</span>
                    <span class="d-none d-lg-block text-start lh-sm"><span class="d-block fw-semibold small">@User.FullName()</span><span class="small opacity-75">@User.RoleDisplay()@(string.IsNullOrEmpty(User.Position()) ? "" : " · " + User.Position())</span></span>
                    <i class="bi bi-chevron-down small d-none d-lg-inline"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><h6 class="dropdown-header">Signed in as <b>@User.Identity?.Name</b></h6></li>
                    <li><a class="dropdown-item" asp-controller="Settings" asp-action="Account"><i class="bi bi-person-circle me-2"></i>My account</a></li>
                    <li><a class="dropdown-item" asp-controller="Settings" asp-action="Account" asp-fragment="password"><i class="bi bi-key me-2"></i>Change password</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- ============ SIDEBAR ============ -->
    <aside class="app-sidebar" aria-label="Main menu">
        <nav class="app-nav">
            @if (Can(Permissions.DashboardView))
            {
                <div class="app-nav-label">Main</div>
                <a class="app-nav-link @A(Is("Dashboard"))" asp-controller="Dashboard" asp-action="Index" title="Dashboard"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
            }

            @if (User.CanAny(Permissions.CashAdvancesView, Permissions.VouchersView))
            {
                <div class="app-nav-label">Disbursements</div>
            }
            @if (Can(Permissions.CashAdvancesView))
            {
                <a class="app-nav-link @A(Is("CashAdvances"))" asp-controller="CashAdvances" asp-action="Index" title="Cash Advances"><i class="bi bi-cash-stack"></i><span>Cash Advances</span></a>
            }
            @if (Can(Permissions.VouchersView))
            {
                <a class="app-nav-link @A(Is("Vouchers", "Index", "Details", "Edit", "Print"))" asp-controller="Vouchers" asp-action="Index" title="Disbursement Vouchers"><i class="bi bi-folder2-open"></i><span>Disbursement Vouchers</span></a>
            }
            @if (Can(Permissions.VouchersEncode))
            {
                <a class="app-nav-link @A(Is("Vouchers", "Upload", "Review"))" asp-controller="Vouchers" asp-action="Upload" title="Upload Scanned DV"><i class="bi bi-cloud-arrow-up"></i><span>Upload Scanned DV</span>@if (alerts.Drafts > 0) { <span class="badge rounded-pill text-bg-warning" title="Scans uploaded but not yet encoded">@alerts.Drafts</span> }</a>
                <a class="app-nav-link @A(Is("Vouchers", "Create"))" asp-controller="Vouchers" asp-action="Create" title="Manual Encode"><i class="bi bi-keyboard"></i><span>Manual Encode</span></a>
            }
            @if (Can(Permissions.VouchersEncode) && Can(Permissions.CashAdvancesEncode))
            {
                <a class="app-nav-link @A(Is("Import"))" asp-controller="Import" asp-action="Index" title="Import MOOE Packet"><i class="bi bi-magic"></i><span>Import MOOE Packet</span></a>
            }

            @if (Can(Permissions.ReportsView))
            {
            <div class="app-nav-label">Reports</div>
            <a class="app-nav-link @A(Is("Reports"))" asp-controller="Reports" asp-action="Index" title="Liquidation Reports"><i class="bi bi-printer"></i><span>Liquidation Reports</span></a>
            }

            @if (canSetup)
            {
                <div class="app-nav-label">Setup</div>
            }
            @if (Can(Permissions.SetupPayees))
            {
                <a class="app-nav-link @A(Is("Setup", "Payees"))" asp-controller="Setup" asp-action="Payees" title="Payees"><i class="bi bi-people"></i><span>Payees</span></a>
            }
            @if (Can(Permissions.SetupAccounts))
            {
                <a class="app-nav-link @A(Is("Setup", "Accounts"))" asp-controller="Setup" asp-action="Accounts" title="UACS Accounts"><i class="bi bi-journal-text"></i><span>UACS Accounts</span></a>
            }
            @if (Can(Permissions.SetupBudgets))
            {
                <a class="app-nav-link @A(Is("Setup", "Budgets"))" asp-controller="Setup" asp-action="Budgets" title="Fund Budgets"><i class="bi bi-piggy-bank"></i><span>Fund Budgets</span></a>
            }
            @if (Can(Permissions.SetupChecklists))
            {
                <a class="app-nav-link @A(Is("Setup", "Checklists", "Checklist"))" asp-controller="Setup" asp-action="Checklists" title="Checklist Templates"><i class="bi bi-list-check"></i><span>Checklist Templates</span></a>
            }
            @if (Can(Permissions.SetupSchool))
            {
                <a class="app-nav-link @A(Is("Setup", "School"))" asp-controller="Setup" asp-action="School" title="School & Signatories"><i class="bi bi-building"></i><span>School &amp; Signatories</span></a>
            }

            <div class="app-nav-label">System</div>
            <button class="app-nav-link @A(Is("Settings"))" type="button" data-bs-toggle="collapse" data-bs-target="#navSettings" aria-expanded="@(Is("Settings") ? "true" : "false")" title="Settings">
                <i class="bi bi-gear"></i><span>Settings</span><i class="bi bi-chevron-right caret"></i>
            </button>
            <ul class="app-nav-sub collapse @(Is("Settings") ? "show" : "")" id="navSettings">
                <li><a class="@A(Is("Settings", "Account"))" asp-controller="Settings" asp-action="Account">My Account</a></li>
                @if (Can(Permissions.SettingsUsers))
                {
                    <li><a class="@A(Is("Settings", "Users"))" asp-controller="Settings" asp-action="Users">Staff Users</a></li>
                }
                @if (Can(Permissions.SettingsRoles))
                {
                    <li><a class="@A(Is("Settings", "Roles"))" asp-controller="Settings" asp-action="Roles">Roles &amp; Access</a></li>
                }
            </ul>
        </nav>
    </aside>
    <div class="app-backdrop" data-ui-sidebar-close></div>

    <!-- ============ PAGE ============ -->
    <main class="app-main">
        <div class="app-pagebar">
            <h1>@title</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Home">Portal</a></li>
                    @foreach (var c in crumbs) { <li class="breadcrumb-item">@c</li> }
                    <li class="breadcrumb-item active" aria-current="page">@title</li>
                </ol>
            </nav>
        </div>
        <div class="app-content">
            @if (User.UsingDefaultPassword())
            {
                <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-shield-exclamation"></i>
                    <div>You are using the default admin password. <a class="alert-link" asp-controller="Settings" asp-action="Account" asp-fragment="password">Change it now</a> before other people use this system.</div>
                </div>
            }
            @if (TempData["ToastError"] is string toastError)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-octagon-fill"></i> <div>@toastError</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Toast"] is string toast)
            {
                <div class="alert alert-info alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-info-circle-fill"></i> <div>@toast</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </div>
        <footer class="app-footer d-flex flex-wrap gap-2">
            <span>DepEd · Division of Zamboanga del Sur · Josefina District — Leonardo National High School</span>
            <span class="ms-auto">Disbursement Archiving Portal</span>
        </footer>
    </main>

    <!-- Shared confirm dialog (use data-ui-confirm="message" on any button/link) -->
    <div class="modal fade" id="uiConfirm" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm"><div class="modal-content">
            <div class="modal-body text-center p-4">
                <i class="bi bi-question-circle text-warning" style="font-size:2.5rem"></i>
                <p class="mt-2 mb-0" data-confirm-text>Are you sure?</p>
            </div>
            <div class="modal-footer justify-content-center border-0 pt-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" data-confirm-ok>Yes, continue</button>
            </div>
        </div></div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script src="~/ui/ui.js" asp-append-version="true"></script>
    <script src="~/ui/ui-grid.js" asp-append-version="true"></script>
    <script src="~/ui/ui-charts.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
