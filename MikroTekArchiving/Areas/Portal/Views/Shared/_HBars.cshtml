@model BarChart
@{
    var items = Model.Display();
    var max = items.Count == 0 ? 1 : items.Max(i => i.Amount);
    var total = items.Sum(i => i.Amount);
}
<div class="viz">
    <div class="viz-title">@Model.Title</div>
    @if (Model.Subtitle is not null) { <div class="viz-sub">@Model.Subtitle</div> }
    @if (items.Count == 0)
    {
        <div class="small text-body-secondary">No amounts yet.</div>
    }
    else
    {
        <div class="hbars" role="list">
            @foreach (var i in items)
            {
                var pct = total == 0 ? 0 : i.Amount / total * 100;
                <div class="lbl" role="listitem">@i.Label @if (i.Sub is not null) { <small>@i.Sub</small> }</div>
                <div class="track"><div class="bar" tabindex="0" style="width:@((i.Amount / max * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"
                     data-tip="<b>@i.Label</b><br />@Fmt.Peso(i.Amount) · @pct.ToString("0.#")% of total"
                     aria-label="@i.Label: @Fmt.Peso(i.Amount)"></div></div>
                <div class="val">@Fmt.Num(i.Amount)<small>@pct.ToString("0")%</small></div>
            }
        </div>
    }
</div>
