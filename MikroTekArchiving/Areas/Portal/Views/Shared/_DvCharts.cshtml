@*  Charts shown on every DV: amount split, cash advance impact, this DV among the advance's DVs,
    the advance by type of spending, and the expense breakdown (when there are 2+ accounts).
    Needs ViewData["CashAdvance"] = the DV's cash advance. *@
@model DvDto
@{
    var ca = (CashAdvanceDto)ViewData["CashAdvance"]!;

    // Cash advance: what was already spent before this DV, this DV, what remains after it.
    var before = ca.Vouchers.Where(v => v.Date < Model.Date || (v.Date == Model.Date && string.CompareOrdinal(v.DvNo, Model.DvNo) < 0)).Sum(v => v.Net);
    var after = ca.Amount - before - Model.Net;

    // Every DV charged to the same cash advance, in DV-number order; this DV is highlighted (emphasis).
    var caDvs = ca.Vouchers.OrderBy(v => v.DvNo).ToList();
    var thisIndex = caDvs.FindIndex(v => v.Id == Model.Id);
    var dvBars = new ChartSpec(ChartType.HBar, caDvs.Select(v => v.DvNo), [new("Net paid", caDvs.Select(v => v.Net))],
        $"DVs charged to {ca.PayrollNo}", $"{caDvs.Count} DVs · net amounts · this DV in blue",
        Height: Math.Max(160, 50 + caDvs.Count * 30), Highlight: thisIndex);

    // The same cash advance split by type of spending (types listed A–Z, as on the dashboard).
    var types = SpendTypes.For(caDvs);
    var myType = SpendTypes.Of(Model, types);
    var typeDonut = new ChartSpec(ChartType.Donut, types,
        [new("Gross", types.Select(t => caDvs.Where(v => SpendTypes.Of(v, types) == t).Sum(v => v.Gross)))],
        $"{ca.PayrollNo} by type of spending", $"Gross amounts · this DV is {myType} (pulled out)",
        Height: 220, Highlight: types.IndexOf(myType));
    // With one DV or one type there is nothing to compare, so those two charts are left out.
    var showComparisons = caDvs.Count > 1;
    var hasBreakdown = Model.Lines.Count > 1;
}
<div class="row g-3">
    <!-- 1. Amount split (kit meter) -->
    <div class="col-md-6">
        <ui-card class="h-100">
            <partial name="UI/_Meter" model="@(new Meter("Where the gross amount goes", Model.Gross,
                [new("Net paid", Model.Net, "s1"), new("Withheld for BIR", Model.Taxes, "s2")],
                $"{Fmt.Peso(Model.Gross)} gross = net paid to payee + tax withheld"))" />
            @if (Model.Taxes == 0) { <div class="small text-body-secondary mt-1">No tax withheld on this DV.</div> }
        </ui-card>
    </div>

    <!-- 2. Cash advance impact (emphasis: this DV in blue, the rest muted) -->
    <div class="col-md-6">
        <ui-card class="h-100">
            <partial name="UI/_Meter" model="@(new Meter($"Charge against cash advance {ca.PayrollNo}", ca.Amount,
                [new("Earlier DVs", before, "muted"), new("This DV", Model.Net, "s1"), new("Left", after, "track")],
                $"{Fmt.Peso(ca.Amount)} released · this DV uses {(ca.Amount == 0 ? 0 : Model.Net / ca.Amount * 100):0.#}%"))" />
        </ui-card>
    </div>

    @if (showComparisons)
    {
    <!-- 3. This DV among all DVs of the cash advance (emphasis bar) -->
    <div class="col-lg-7">
        <ui-card class="h-100">
            <partial name="UI/_Chart" model="@dvBars" />
        </ui-card>
    </div>

    <!-- 4. Cash advance by type of spending (donut, part-to-whole) -->
    <div class="col-lg-5">
        <ui-card class="h-100">
            <partial name="UI/_Chart" model="@typeDonut" />
        </ui-card>
    </div>

    }

    @if (hasBreakdown)
    {
        <!-- 5. Expense breakdown by UACS (only when the DV has 2+ account lines; one line would be a one-bar chart) -->
        <div class="col-12">
            <ui-card class="h-100">
                <partial name="UI/_Chart" model="@(new ChartSpec(ChartType.HBar, Model.Lines.Select(x => x.Title), [new("Gross", Model.Lines.Select(x => x.Amount))],
                    "Expense breakdown by UACS account", $"{Model.Lines.Count} account lines · gross {Fmt.Peso(Model.Gross)}", Height: Math.Max(120, 60 + Model.Lines.Count * 40)))" />
            </ui-card>
        </div>
    }
</div>
