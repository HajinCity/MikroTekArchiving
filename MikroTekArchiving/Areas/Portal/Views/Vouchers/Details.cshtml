@model DvDto
@{
    ViewData["Title"] = Model.DvNo;
    ViewData["Crumb"] = "Disbursements / DV Archive";
    var ca = (CashAdvanceDto)ViewData["CashAdvance"]!;
    var school = (SchoolProfileDto)ViewData["School"]!;
    var canEdit = User.Can(Permissions.VouchersEncode);
    string Dash(string? text) => string.IsNullOrWhiteSpace(text) ? "—" : text;
    var files = (MikroTek.Archiving.Areas.Portal.Models.FilesPanel)ViewData["Files"]!;
}
<div class="page-actions">
    <span class="dept dept-@Model.Dept">@Model.Dept</span>
    @if (Model.IsComplete) { <span class="badge-status st-complete"><i class="bi bi-check2-circle"></i> Packet complete</span> }
    else { <span class="badge-status st-incomplete"><i class="bi bi-exclamation-circle"></i> @Model.DocsMissing document(s) missing</span> }
    @if (Model.PaidDate is not null) { <span class="badge-status st-closed">PAID @Fmt.Date(Model.PaidDate)</span> }
    else { <span class="badge-status st-open">Not yet paid</span> }
    <span class="me-auto"></span>
    @if (canEdit)
    {
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button class="btn btn-outline-danger" title="Delete this DV" data-ui-confirm="Delete DV @Model.DvNo with its checklist and scanned files? This cannot be undone."><i class="bi bi-trash"></i></button>
        </form>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil me-1"></i>Edit</a>
    }
    <a class="btn btn-primary" asp-action="Print" asp-route-id="@Model.Id"><i class="bi bi-printer me-1"></i>Print archive record</a>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-dv" type="button">Voucher</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-charts" type="button"><i class="bi bi-bar-chart-line me-1"></i>Charts</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-check" type="button">Checklist <span class="badge text-bg-light">@Model.DocsDone/@Model.Checklist.Count</span></button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-files" type="button">Scanned files <span class="badge text-bg-light">@files.Files.Count</span></button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-log" type="button">History</button></li>
        </ul>
        <div class="tab-content">
            <!-- VOUCHER -->
            <div class="tab-pane fade show active" id="tab-dv">
                <div class="card mb-3">
                    <div class="card-header">Disbursement Voucher <span class="sub">— Appendix 32</span></div>
                    <div class="card-body">
                        <div class="row g-3 small">
                            <div class="col-md-4"><div class="text-body-secondary">DV No.</div><div class="fw-semibold fs-6">@Model.DvNo</div></div>
                            <div class="col-md-4"><div class="text-body-secondary">DV Date</div><div class="fw-semibold">@Fmt.LongDate(Model.Date)</div></div>
                            <div class="col-md-4"><div class="text-body-secondary">Fund Cluster</div><div class="fw-semibold">@Dash(Model.FundCluster)</div></div>
                            <div class="col-md-8"><div class="text-body-secondary">Payee</div><div class="fw-semibold">@Model.Payee</div><div>@Model.Address</div></div>
                            <div class="col-md-4"><div class="text-body-secondary">TIN / Employee No.</div><div class="fw-semibold mono">@Model.Tin</div></div>
                            <div class="col-12"><div class="text-body-secondary">Particulars</div><div>@Model.Particulars</div></div>
                            <div class="col-md-4"><div class="text-body-secondary">Responsibility Center</div><div>@Dash(Model.ResponsibilityCenter)</div></div>
                            <div class="col-md-4"><div class="text-body-secondary">MFO/PAP</div><div>@Dash(Model.MfoPap)</div></div>
                            <div class="col-md-4"><div class="text-body-secondary">Transaction type</div><div>@Dash(Model.Type)</div></div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">Accounting Entry</div>
                    <div class="table-responsive">
                        <table class="table table-portal">
                            <thead><tr><th>Account Title</th><th>UACS Code</th><th class="num">Debit</th><th class="num">Credit</th></tr></thead>
                            <tbody>
                                @foreach (var l in Model.Lines) { <tr><td>@l.Title</td><td class="mono">@l.Code</td><td class="num">@Fmt.Num(l.Amount)</td><td></td></tr> }
                                @if (Model.Tax1 > 0) { <tr><td class="ps-4">Due to BIR — 1%</td><td class="mono">2020101000</td><td></td><td class="num">@Fmt.Num(Model.Tax1)</td></tr> }
                                @if (Model.Tax3 > 0) { <tr><td class="ps-4">Due to BIR — 3%</td><td class="mono">2020101000</td><td></td><td class="num">@Fmt.Num(Model.Tax3)</td></tr> }
                                <tr><td class="ps-4">Advances for Operating Expenses</td><td class="mono">1990101000</td><td></td><td class="num">@Fmt.Num(Model.Net)</td></tr>
                            </tbody>
                            <tfoot class="fw-semibold"><tr><td colspan="2" class="text-end">Totals</td><td class="num">@Fmt.Num(Model.Gross)</td><td class="num">@Fmt.Num(Model.Gross)</td></tr></tfoot>
                        </table>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">Payment</div>
                    <div class="card-body row g-3 small">
                        <div class="col-md-3"><div class="text-body-secondary">Mode</div><div class="fw-semibold">@Dash(Model.Mode)</div></div>
                        <div class="col-md-3"><div class="text-body-secondary">Check / ADA No.</div><div class="fw-semibold mono">@Dash(Model.CheckNo)</div></div>
                        <div class="col-md-3"><div class="text-body-secondary">Date paid</div><div class="fw-semibold">@Dash(Fmt.Date(Model.PaidDate))</div></div>
                        <div class="col-md-3"><div class="text-body-secondary">Bank / Account</div><div>@Dash(Model.Bank)</div></div>
                        <div class="col-md-6"><div class="text-body-secondary">Received by</div><div class="fw-semibold">@Dash(Model.ReceivedBy)</div></div>
                        <div class="col-md-3"><div class="text-body-secondary">OR / Invoice No.</div><div>@Dash(Model.OrNo)</div></div>
                        <div class="col-md-3"><div class="text-body-secondary">JEV No.</div><div>@Dash(Model.JevNo)</div></div>
                    </div>
                </div>
            </div>

            <!-- CHARTS -->
            <div class="tab-pane fade" id="tab-charts">
                <partial name="_DvCharts" model="Model" />
            </div>

            <!-- CHECKLIST -->
            <div class="tab-pane fade" id="tab-check">
                <form class="card" asp-action="SaveChecklist" asp-route-id="@Model.Id" method="post">
                    <div class="card-header d-flex align-items-center">
                        <span>@(Model.Type.Length == 0 ? "Checklist" : Model.Type)</span>
                        <span class="ms-auto small text-body-secondary">✓ = attached · NA = not applicable · blank = missing</span>
                    </div>
                    <div class="card-body checklist">
                        @if (Model.Checklist.Count == 0)
                        {
                            <div class="text-body-secondary small mb-3"><i class="bi bi-info-circle me-1"></i>This DV has no checklist. Choose a transaction type on <b>Edit</b> to give it one.</div>
                        }
                        @for (var i = 0; i < Model.Checklist.Count; i++)
                        {
                            var c = Model.Checklist[i];
                            <div class="item">
                                <div class="btn-group btn-group-sm" role="group">
                                    <input type="radio" class="btn-check" name="check[@i].Mark" value="✓" id="m@(i)y" checked="@(c.Mark == "✓")" disabled="@(!canEdit)" /><label class="btn btn-outline-success btn-mark" for="m@(i)y" title="Attached">✓</label>
                                    <input type="radio" class="btn-check" name="check[@i].Mark" value="NA" id="m@(i)n" checked="@(c.Mark == "NA")" disabled="@(!canEdit)" /><label class="btn btn-outline-secondary btn-mark" for="m@(i)n" title="Not applicable">NA</label>
                                    <input type="radio" class="btn-check" name="check[@i].Mark" value="" id="m@(i)x" checked="@(c.Mark == "")" disabled="@(!canEdit)" /><label class="btn btn-outline-danger btn-mark" for="m@(i)x" title="Missing"><i class="bi bi-dash"></i></label>
                                </div>
                                <div class="label @(c.Mark == "" ? "text-danger fw-semibold" : "")">@c.Label</div>
                                <input class="form-control form-control-sm" style="width:90px" name="check[@i].Date" maxlength="20" placeholder="date" value="@c.Date" readonly="@(!canEdit)" aria-label="Date for @c.Label" />
                            </div>
                        }
                        <div class="mt-3">
                            <label class="form-label">Remarks</label>
                            <textarea class="form-control" rows="2" name="remarks" maxlength="500" readonly="@(!canEdit)">@Model.ChecklistRemarks</textarea>
                        </div>
                    </div>
                    <div class="card-footer bg-white d-flex align-items-center">
                        <span class="small text-body-secondary">@(string.IsNullOrWhiteSpace(school.BookkeeperName) ? "" : $"Checked by: {school.BookkeeperName}{(string.IsNullOrWhiteSpace(school.BookkeeperPosition) ? "" : ", " + school.BookkeeperPosition)}")</span>
                        @if (canEdit)
                        {
                            <button class="btn btn-primary ms-auto"><i class="bi bi-save me-1"></i>Save checklist</button>
                        }
                    </div>
                </form>
            </div>

            <!-- FILES -->
            <div class="tab-pane fade" id="tab-files">
                <div class="card">
                    <div class="card-body">
                        <partial name="_Files" model="files" />
                    </div>
                </div>
            </div>

            <!-- HISTORY -->
            <div class="tab-pane fade" id="tab-log">
                <div class="card"><ul class="list-group list-group-flush small">
                    @foreach (var f in files.Files.OrderByDescending(x => x.UploadedAt))
                    {
                        <li class="list-group-item"><b>@(f.UploadedBy ?? "Someone")</b> uploaded @f.FileName <span class="text-body-secondary float-end">@f.UploadedAt.ToString("MM/dd/yyyy h:mm tt")</span></li>
                    }
                    @if (Model.UpdatedAt is { } changed)
                    {
                        <li class="list-group-item"><b>@(Model.UpdatedBy ?? "Someone")</b> last changed the voucher or its checklist <span class="text-body-secondary float-end">@changed.ToString("MM/dd/yyyy h:mm tt")</span></li>
                    }
                    <li class="list-group-item"><b>@(Model.EncodedBy ?? "Someone")</b> created the record <span class="text-body-secondary float-end">@Model.EncodedAt.ToString("MM/dd/yyyy h:mm tt")</span></li>
                </ul></div>
            </div>
        </div>
    </div>

    <!-- RIGHT: amounts summary -->
    <div class="col-xl-4">
        <div class="card summary-card">
            <div class="card-header">Amount</div>
            <div class="card-body">
                <div class="row-amt"><span>Gross amount</span><span>@Fmt.Peso(Model.Gross)</span></div>
                <div class="row-amt text-body-secondary"><span>Less 1% withholding</span><span>@Fmt.Acct(-Model.Tax1)</span></div>
                <div class="row-amt text-body-secondary"><span>Less 3% withholding</span><span>@Fmt.Acct(-Model.Tax3)</span></div>
                <div class="row-amt total"><span>Net amount paid</span><span>@Fmt.Peso(Model.Net)</span></div>
                <hr />
                <div class="small text-body-secondary mb-1">Charged to cash advance</div>
                <a class="fw-semibold text-decoration-none" asp-controller="CashAdvances" asp-action="Details" asp-route-id="@ca.Id">@ca.PayrollNo</a>
                <div class="small">@ca.Dept · @ca.FundName · Batch @ca.BatchNo.ToString("00") · balance @Fmt.Peso(ca.Balance)</div>
                <hr />
                <div class="small text-body-secondary mb-2">Supporting documents</div>
                <div class="progress mb-1"><div class="progress-bar @(Model.DocsMissing == 0 ? "bg-success" : "bg-warning")" style="width:@(Model.Checklist.Count == 0 ? 0 : Model.DocsDone * 100 / Model.Checklist.Count)%"></div></div>
                <div class="small">@Model.DocsDone of @Model.Checklist.Count accounted for</div>
            </div>
        </div>
    </div>
</div>
