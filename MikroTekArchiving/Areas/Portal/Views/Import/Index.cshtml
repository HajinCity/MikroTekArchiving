@model ImportPage
@{
    ViewData["Title"] = "Import MOOE Packet";
    ViewData["Crumb"] = "Disbursements";
}
<div class="row g-3">
    <div class="col-xl-8">
        @if (!Model.Status.Ready)
        {
            <div class="alert alert-warning" role="alert">
                <div class="d-flex gap-2"><i class="bi bi-exclamation-triangle-fill"></i>
                    <div>
                        <b>The scan reader cannot start on this server yet.</b> Packets cannot be read until it does.
                        <div class="small mt-1">@Model.Status.Message</div>
                        <div class="small mt-2 text-body-secondary">The reader is built into the portal (NuGet package "Tesseract" with its language files in the
                            <span class="mono">tessdata</span> folder), so normally nothing has to be installed. Settings: <span class="mono">appsettings.json → "Ocr"</span>.</div>
                    </div>
                </div>
            </div>
        }
        <form asp-action="Read" method="post" enctype="multipart/form-data" class="card" id="importForm">
            <div class="card-body">
                <label class="dropzone d-block upload-drop" for="packetFile" id="drop">
                    <i class="bi bi-file-earmark-pdf d-block mb-2" style="font-size:2.6rem"></i>
                    <div class="fw-bold text-body fs-5">Drop the finished MOOE packet here</div>
                    <div class="mb-3">One scanned PDF with the MOOE slip, the Alphalist of payees and the Cash Disbursements Register</div>
                    <input type="file" id="packetFile" name="file" class="d-none" accept=".pdf,.jpg,.jpeg,.png" />
                    <span class="btn btn-primary"><i class="bi bi-folder2-open me-1"></i>Choose file</span>
                    <div class="small mt-3">PDF (or a JPG/PNG of one page) · up to 100 MB</div>
                </label>
                <div id="picked" class="mt-3"></div>
                <div id="reading" class="alert alert-info mt-3 mb-0 d-none" role="status">
                    <div class="d-flex align-items-center gap-2">
                        <span class="spinner-border spinner-border-sm"></span>
                        <div><b>Reading the pages…</b> This takes about 15 seconds per page. Please keep this page open.</div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white d-flex align-items-center gap-2">
                <span class="small text-body-secondary"><i class="bi bi-shield-lock me-1"></i>Read on the school's server — the scan never leaves the school.</span>
                <button class="btn btn-primary ms-auto" id="readBtn" disabled><i class="bi bi-magic me-1"></i>Read packet</button>
            </div>
        </form>
    </div>

    <div class="col-xl-4">
        <div class="card mb-3">
            <div class="card-header">How it works</div>
            <div class="card-body small">
                <div class="d-flex gap-2 mb-3"><span class="step">1</span><div><b>Upload</b> the whole packet as one PDF. The pages are read on the server: the register gives each DV, its accounts and taxes; the Alphalist gives the TINs.</div></div>
                <div class="d-flex gap-2 mb-3"><span class="step">2</span><div><b>Check</b> what was read beside the scan. The figures are compared with each other (payments, running balance, totals, recapitulation); anything unclear is marked in <span class="text-warning-emphasis fw-semibold">yellow</span>, anything that does not add up in <span class="text-danger fw-semibold">red</span>.</div></div>
                <div class="d-flex gap-2"><span class="step">3</span><div><b>Save</b>: the cash advance and all its DVs are created in one go, and the PDF is attached to the cash advance.</div></div>
            </div>
        </div>
        <div class="card">
            <div class="card-header">For the best reading</div>
            <div class="card-body small">
                <ul class="mb-0 ps-3">
                    <li>Scan at 150–300 dpi. Pages may be sideways or upside down; they are turned automatically.</li>
                    <li>Handwriting (the ADA No. on the MOOE slip) cannot be read; you type it on the next page.</li>
                    <li>Only one DV to add? Use <a asp-controller="Vouchers" asp-action="Upload">Upload Scanned DV</a> instead.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const input = document.getElementById("packetFile"), drop = document.getElementById("drop");
    const picked = document.getElementById("picked"), btn = document.getElementById("readBtn");
    function show(files) {
        const f = files[0];
        picked.replaceChildren();
        btn.disabled = !f;
        if (!f) return;
        const row = document.createElement("div"); row.className = "file-row";
        row.innerHTML = `<i class="bi ${f.type.includes("pdf") ? "bi-file-earmark-pdf" : "bi-file-earmark-image"} ficon"></i>
            <div class="flex-fill"><div class="fw-semibold file-name"></div><div class="small text-body-secondary">${(f.size / 1048576).toFixed(1)} MB</div></div>
            <span class="badge-status st-open">Ready</span>`;
        row.querySelector(".file-name").textContent = f.name;
        picked.append(row);
    }
    input.addEventListener("change", () => show(input.files));
    ["dragover", "dragenter"].forEach(e => drop.addEventListener(e, ev => { ev.preventDefault(); drop.classList.add("over"); }));
    ["dragleave", "drop"].forEach(e => drop.addEventListener(e, ev => { ev.preventDefault(); drop.classList.remove("over"); }));
    drop.addEventListener("drop", ev => { input.files = ev.dataTransfer.files; show(input.files); });
    document.getElementById("importForm").addEventListener("submit", () => {
        btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Reading…';
        document.getElementById("reading").classList.remove("d-none");
    });
})();
</script>
}
