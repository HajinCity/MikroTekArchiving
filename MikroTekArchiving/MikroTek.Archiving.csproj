<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Publish only English resource files (smaller output for the server PC). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MikroTek.Domain\MikroTek.Domain.csproj" />
    <ProjectReference Include="..\MikroTek.Services\MikroTek.Services.csproj" />
  </ItemGroup>

  <!-- Server scripts + guide (deploy folder) are copied next to MikroTek.Archiving.exe when publishing. -->
  <ItemGroup>
    <None Remove="deploy\**" />
    <None Include="deploy\**\*" CopyToPublishDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Keep these folders visible in Solution Explorer even while they are empty. -->
  <ItemGroup>
    <Folder Include="App_Data\" />
    <Folder Include="Content\" />
    <Folder Include="plugins\" />
    <Folder Include="Scripts\" />
    <Folder Include="Utility\" />
  </ItemGroup>

</Project>
